{
  "manifest_version": 3,
  "name": "Make X Great Again",
  "version": "0.5.1",
  "description": "在 X 时间线上查看作者的关注数，快速关注、取关、屏蔽或标记不感兴趣。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/mxga-16.png",
    "32": "icons/mxga-32.png",
    "48": "icons/mxga-48.png",
    "128": "icons/mxga-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": [
        "x-data.js",
        "direct-links.js",
        "copy.js",
        "post-actions/native-menu.js",
        "post-actions/post-card-actions.js",
        "native-translation.js",
        "articles/article-markdown.js",
        "articles/article-metadata.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
